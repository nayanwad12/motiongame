{
  "name": "one-shape",
  "version": "1.0.0",
  "description": "One shape, 12 UI states, 7 bars at 120 BPM",
  "scripts": {
    "build": "node tools/build.mjs",
    "stills": "node tools/build.mjs && node tools/stills.mjs && python3 tools/sheet.py",
    "song": "python3 tools/placeholder_song.py out/placeholder_song.wav",
    "audio": "cd tools && python3 audio.py --cues ../out/cues.json --out ../out/audio.wav",
    "render": "node tools/build.mjs && node tools/render.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nayanwad12/motiongame.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/nayanwad12/motiongame/issues"
  },
  "homepage": "https://github.com/nayanwad12/motiongame#readme",
  "dependencies": {
    "geist": "^1.7.2",
    "playwright": "1.56"
  },
  "type": "module"
}
